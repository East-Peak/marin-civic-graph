# Operator-local settings for the weekly LaunchAgent. Copy to weekly.env (gitignored), fill in,
# then `chmod 600 ops/launchd/weekly.env`. run-weekly-stage.sh sources it; install.sh checks it.

# Healthchecks.io ping URL of the check "Open Marin weekly review ready". It embeds the check's
# secret: never commit it, paste it into a log, or share it.
OPEN_MARIN_HEARTBEAT_URL=

# CourtListener API token (courtlistener.com → profile → API Token; free account). Anonymous
# search is throttled into 429s mid-run. Also a secret: never commit it or paste it anywhere.
COURTLISTENER_API_TOKEN=

# Optional per-step timeout overrides, in seconds (defaults: STEP_TIMEOUTS in scripts/refresh_weekly.py).
# OPEN_MARIN_TIMEOUT_STAGE_COURTLISTENER=
# OPEN_MARIN_TIMEOUT_INGEST_GRANICUS=
