{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead-code gate (2026-07-03). Gates dead FILES + unused DEPENDENCIES so new
  // dead code fails `verify`. Export/type checks deferred to a later triage.
  "include": ["files", "dependencies"],
  "ignore": [
    // --- FALSE POSITIVES — keep permanently ---
    // Build-copied into src/app/(operator-workbench)/ by
    // scripts/copy-operator-workbench.mjs (predev/prebuild); not dead.
    "operator-workbench-src/**",
    "src/lib/operator-gate.ts", // consumed by the operator-workbench feature
    // Deliberate ad-hoc diagnostic (its header: "Not part of the build/test
    // pipeline"); connects to live AuraDB. Kept as a manual utility, not dead.
    "scripts/smoke-data-queries.mjs",
  ],
  "ignoreDependencies": [
    "@types/cytoscape", // FALSE POSITIVE: ambient types for cytoscape (used in src)
  ],
}
