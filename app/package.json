{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-operator-workbench.mjs && node scripts/copy-subgraphs.mjs",
    "dev": "next dev",
    "predev:operator": "OPERATOR_WORKBENCH=1 node scripts/copy-operator-workbench.mjs && node scripts/copy-subgraphs.mjs",
    "dev:operator": "OPERATOR_WORKBENCH=1 OPERATOR_REPO_ROOT=$(cd .. && pwd) OPERATOR_PYTHON=$(cd .. && pwd)/.venv/bin/python next dev -H 127.0.0.1",
    "prebuild": "node scripts/copy-operator-workbench.mjs && node scripts/copy-subgraphs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && knip && npm test",
    "check:operator-exclusion": "node scripts/check-operator-exclusion.mjs"
  },
  "dependencies": {
    "@cosmograph/cosmos": "^1.6.1",
    "cytoscape": "^3.33.2",
    "cytoscape-fcose": "^2.2.0",
    "neo4j-driver": "^6.0.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "knip": "^6.24.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
